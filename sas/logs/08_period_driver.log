1372       /*----------------------------------------------------------------------------------------------
1373          08_period_driver.sas - one payment summary per active reporting month, driven by a table.
1374       
1375          What it does:
1376            1. reads the months with active_flag = 1 from the reporting-periods table into one list
1377               (202509 202510 202511 202512);
1378            2. %period_driver loops over that list and calls %run_period for each month;
1379            3. %run_period keeps that month's payments and calls %summarize (program 06): total and average
1380               payment for on-time vs late payments, saved as out.period_summary_<month>.
1381            MPRINT is written to &root/logs/08_period_driver_mprint.sas: the code the macros generated,
1382            with the real table names.
1383          Reads:  out.delinquency (program 04), ctrl.reporting_periods, program 06 (%include)
1384          Writes: out.period_summary_202509 ... _202512 (one table per active month)
1385          Trap:   three levels of nested macros, a loop driven by data, and table names built at run time
1386                  (out.period_summary_&pid): switching one more month to active in the table creates one
1387                  more output table, without changing the code.
1388       ----------------------------------------------------------------------------------------------*/
1389       libname ctrl "&root/ctrl";
1390       libname out  "&root/out";
1391       
1392       filename mprint "&root/logs/08_period_driver_mprint.sas";
1393       options mprint mfile;
1394       
1395       %include "&root/programs/06_macro_library.sas";
1421       
1422       proc sql noprint;
1423         select period_id into :period_list separated by ' '
1424         from ctrl.reporting_periods
1425         where active_flag = 1
1426         order by period_id;
1427       quit;
1428       
1429       %macro run_period(pid);
1430         data work.pay_&pid;
1431           set out.delinquency;
1432           where period_id = "&pid";
1433         run;
1434         %summarize(ds=work.pay_&pid, class=delinquent_flag, var=payment_amount,
1435                    out=out.period_summary_&pid);
1436       %mend run_period;
1437       
1438       %macro period_driver;
1439         %local i pid;
1440         %do i = 1 %to %sysfunc(countw(&period_list, %str( )));
1441           %let pid = %scan(&period_list, &i, %str( ));
1442           %run_period(&pid);
1443         %end;
1444       %mend period_driver;
1445       
1446       %period_driver;
MPRINT(RUN_PERIOD):   data work.pay_202509;
MPRINT(RUN_PERIOD):   set out.delinquency;
MPRINT(RUN_PERIOD):   where period_id = "202509";
MPRINT(RUN_PERIOD):   run;
MPRINT(SUMMARIZE):   proc means data=work.pay_202509 noprint nway;
MPRINT(SUMMARIZE):   class delinquent_flag;
MPRINT(SUMMARIZE):   var payment_amount;
MPRINT(SUMMARIZE):   output out=out.period_summary_202509(drop=_type_ _freq_) n=n sum=total mean=avg;
MPRINT(SUMMARIZE):   run;
MPRINT(RUN_PERIOD):  ;
MPRINT(PERIOD_DRIVER):  ;
MPRINT(RUN_PERIOD):   data work.pay_202510;
