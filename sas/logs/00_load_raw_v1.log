812        /*----------------------------------------------------------------------------------------------
813           00_load_raw.sas - load the generated CSV files into SAS tables (.sas7bdat).
814        
815           What it does: reads each CSV in &root/raw with a DATA step (INFILE + INPUT) and saves it as a
816             permanent SAS table. Every column gets an explicit type and length (LENGTH), and dates are read
817             with the yymmdd10. informat. No PROC IMPORT: it would guess types and lengths.
818           Reads:  &root/raw/*.csv (7 files, UTF-8)
819           Writes: ctrl.client_segments, ctrl.reporting_periods, ctrl.macro_parameters,
820                   stg.customers, stg.loans, stg.loan_payments, stg.card_transactions
821           Checks: prints the longest customer name in bytes (expect 30) and the missing incomes (expect 15).
822           Trap:   SAS lengths count BYTES and SAS cuts longer text silently. The customer_name length is
823                   set in one place (&name_len): v1 = $12 cuts names, v2 = $60 keeps them all.
824                   python/sas_load.py runs both versions; &root is set by python/sas_session.py.
825        ----------------------------------------------------------------------------------------------*/
826        libname stg  "&root/stg";
827        libname ctrl "&root/ctrl";
828        
829        %let name_len = $12;   /* v1 = $12 (too short, cuts names) | v2 = $60 (correct) */
830        
831        filename f_seg "&root/raw/ctrl_client_segments.csv" encoding="utf-8";
832        data ctrl.client_segments;
833          infile f_seg dsd firstobs=2 truncover;
834          length segment_code $10 segment_name $60 risk_band $10 min_income 8 max_income 8;
835          input segment_code $ segment_name $ risk_band $ min_income max_income;
836        run;
837        
838        filename f_per "&root/raw/ctrl_reporting_periods.csv" encoding="utf-8";
839        data ctrl.reporting_periods;
840          infile f_per dsd firstobs=2 truncover;
841          length period_id $6 period_start 8 period_label $20 active_flag 8;
842          informat period_start yymmdd10.;
843          format period_start yymmdd10.;
844          input period_id $ period_start period_label $ active_flag;
845        run;
846        
847        filename f_par "&root/raw/ctrl_macro_parameters.csv" encoding="utf-8";
848        data ctrl.macro_parameters;
849          infile f_par dsd firstobs=2 truncover;
850          length param_name $32 param_value $32;
851          input param_name $ param_value $;
852        run;
853        
854        filename f_cus "&root/raw/customers.csv" encoding="utf-8";
855        data stg.customers(label="customers loaded by 00_load_raw, customer_name length &name_len");
856          infile f_cus dsd firstobs=2 truncover;
857          length customer_id 8 customer_name &name_len city $40 province $2
858                 segment_code $10 annual_income 8 customer_since 8;
859          informat customer_since yymmdd10.;
860          format customer_since yymmdd10.;
861          input customer_id customer_name $ city $ province $ segment_code $
862                annual_income customer_since;
863        run;
864        
865        filename f_loa "&root/raw/loans.csv" encoding="utf-8";
866        data stg.loans;
867          infile f_loa dsd firstobs=2 truncover;
868          length loan_id 8 customer_id 8 loan_type $12 origination_date 8 principal 8
869                 interest_rate 8 term_months 8 status $10 monthly_payment 8;
870          informat origination_date yymmdd10.;
871          format origination_date yymmdd10.;
872          input loan_id customer_id loan_type $ origination_date principal
873                interest_rate term_months status $ monthly_payment;
874        run;
875        
876        filename f_pay "&root/raw/loan_payments.csv" encoding="utf-8";
877        data stg.loan_payments;
878          infile f_pay dsd firstobs=2 truncover;
879          length loan_id 8 payment_date 8 payment_amount 8 principal_paid 8
880                 interest_paid 8 days_past_due 8;
881          informat payment_date yymmdd10.;
882          format payment_date yymmdd10.;
883          input loan_id payment_date payment_amount principal_paid interest_paid days_past_due;
884        run;
885        
886        filename f_crd "&root/raw/card_transactions.csv" encoding="utf-8";
887        data stg.card_transactions;
888          infile f_crd dsd firstobs=2 truncover;
889          length transaction_id 8 customer_id 8 transaction_date 8 merchant_category $20
890                 amount 8 fraud_flag 8;
891          informat transaction_date yymmdd10.;
892          format transaction_date yymmdd10.;
893          input transaction_id customer_id transaction_date merchant_category $ amount fraud_flag;
894        run;
895        
896        /* quick check: longest customer name in bytes (CSV value: 30) and missing incomes (CSV: 15) */
897        proc sql;
898          select max(length(customer_name)) as max_name_bytes,
899                 nmiss(annual_income)       as missing_income
900          from stg.customers;
901        quit;
