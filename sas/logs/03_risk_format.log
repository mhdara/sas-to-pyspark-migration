1161       /*----------------------------------------------------------------------------------------------
1162          03_risk_format.sas - label each customer's income with a user-defined format.
1163       
1164          What it does: PROC FORMAT defines "incband", a lookup from income ranges to labels
1165            (LOW < 20,000, MID < 80,000, HIGH >= 80,000, anything else UNKNOWN); a DATA step applies it
1166            with PUT() to every customer.
1167          Reads:  out.customers_clean (program 01)
1168          Writes: out.customer_risk (500 rows)
1169          Trap:   Python and Spark have no PROC FORMAT: the ranges must be rebuilt as conditions, with the
1170                  same open/closed bounds. OTHER also catches missing values, so here a missing income is
1171                  UNKNOWN, while program 01 puts the same customers in LOW.
1172       ----------------------------------------------------------------------------------------------*/
1173       libname out "&root/out";
1174       
1175       proc format;
1176         value incband
1177           low -< 20000   = 'LOW'
1178           20000 -< 80000 = 'MID'
1179           80000 - high   = 'HIGH'
1180           other          = 'UNKNOWN';
1180     !                                   /* OTHER also catches missing values */
1181       run;
1182       
1183       data out.customer_risk;
1184         set out.customers_clean;
1185         length income_band_fmt $7;
1186         income_band_fmt = put(annual_income, incband.);
1187       run;
